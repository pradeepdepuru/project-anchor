{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "scripts": {
    "build": "npx sanity@latest build",
    "deploy": "npx sanity@latest deploy",
    "predev": "npm run sanity:typegen",
    "dev": "npx sanity@latest dev",
    "sanity:typegen": "npx sanity@latest schema extract --enforce-required-fields --path ../sanity.schema.json && npx sanity@latest typegen generate",
    "start": "npx sanity@latest start",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/assist": "^6.0.7",
    "@sanity/icons": "^3.7.4",
    "@sanity/vision": "^5.31.1",
    "@sanity/workflow-blueprint": "^0.36.0",
    "@sanity/workflow-cli": "^0.36.0",
    "@sanity/workflow-engine": "^0.36.0",
    "date-fns": "^4.4.0",
    "pluralize-esm": "^9.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.2",
    "sanity": "^5.31.1",
    "sanity-plugin-asset-source-unsplash": "^7.0.7",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.16",
    "typescript": "^5.9.3"
  }
}
